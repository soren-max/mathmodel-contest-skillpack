{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "paper_metrics.schema.json",
  "title": "GMCM paper metric registry",
  "type": "object",
  "required": ["schema_version", "metrics"],
  "properties": {
    "schema_version": {"const": 1},
    "metrics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["question", "metric_id", "description", "value", "unit", "definition", "source_script", "source_result", "source_field", "rounding", "validation_status", "approved_for_paper", "notes"],
        "properties": {
          "question": {"type": "string", "minLength": 1},
          "metric_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]*$"},
          "description": {"type": "string"},
          "value": {"type": ["number", "integer", "string", "boolean", "null"]},
          "unit": {"type": ["string", "null"]},
          "definition": {"type": "string", "minLength": 1},
          "source_script": {"type": "string", "minLength": 1},
          "source_result": {"type": "string", "minLength": 1},
          "source_field": {"type": "string", "minLength": 1},
          "rounding": {"type": "string", "minLength": 1},
          "validation_status": {"enum": ["PASS", "UNVERIFIED", "CONFLICT", "DEFINITION_RISK", "UNIT_CONFLICT"]},
          "approved_for_paper": {"type": "boolean"},
          "notes": {"type": "string"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
